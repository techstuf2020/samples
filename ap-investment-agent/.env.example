# Copy to /etc/ap-investment-agent.env and fill in. Never commit the real file.

# Claude Code sign-in token for your Claude Pro plan: run `claude setup-token` and paste it here
CLAUDE_CODE_OAUTH_TOKEN=

# Gmail account that sends the report, and a Gmail App Password (not your normal password):
# Google Account > Security > 2-Step Verification > App passwords
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=

# Where the report goes
REPORT_TO=you@gmail.com

# Optional
# SMTP_HOST=smtp.gmail.com
# To use the Claude API instead of Claude Code (billed per use):
# BACKEND=api
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
